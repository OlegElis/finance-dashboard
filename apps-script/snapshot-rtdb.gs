/** Диагностика: печатает в журнал meta из базы и локальную контрольную сумму. Ничего не пишет. */
function snapshotStatus() {
  var meta = rtdbGet_(ROOT + '/meta');
  Logger.log('meta в базе: ' + (meta ? JSON.stringify(meta) : '(нет - снимок ещё не публиковался)'));

  var p = PropertiesService.getScriptProperties();
  Logger.log('локально запомнено: сумма=' + (p.getProperty('sum') || '-') +
             ' · поколение=' + (p.getProperty('gen') || '-') +
             ' · публикация=' + (p.getProperty('publishedAt') || '-'));
  var lastAbort = p.getProperty('lastAbort');
  if (lastAbort) Logger.log('последний отказ: ' + lastAbort);

  var mins = sincePub_(meta);
  Logger.log('ограничение частоты: ' + (mins == null ? 'публикаций ещё не было' :
             'с прошлой публикации ' + Math.round(mins) + ' мин из ' + MIN_PUBLISH_MIN +
             (mins < MIN_PUBLISH_MIN ? ' - публикация сейчас была бы отложена' : ' - окно открыто')) +
             (p.getProperty('deferred') === '1' ? ' · ⚠ есть ОТЛОЖЕННАЯ правка, ждёт окна' : ''));

  // Рубежи: сначала что запомнено, потом что сейчас. gates_ ничего не записывает - диагностика
  // не должна менять состояние скрипта, иначе следующий прогон пропустит правку, о которой
  // человек как раз и пришёл спрашивать.
  var g = gates_(p);
  var wasS = (p.getProperty('sandboxMtimes') || '').split('|');
  Logger.log('рубежи запомнены: мастер=' + _mtimeTxt(p.getProperty('srcMtime')) +
             ' · песочницы=' + wasS.map(_mtimeTxt).join(' | ') +
             (p.getProperty('sandboxRetry') ? ' · ⚠ ждём IMPORTRANGE, попытка ' +
              p.getProperty('sandboxRetry') + ' из ' + SBX_RETRY_MAX : ''));
  Logger.log('рубежи сейчас: ' + (g.hit ? 'СРАБОТАЛ - ' + g.why : 'молчат, полное чтение не потребовалось бы') +
             ' (мастер=' + _mtimeTxt(g.mtime) + ' · песочницы=' +
             String(g.sbx).split('|').map(_mtimeTxt).join(' | ') + ')' +
             ' · время файла ' + g.tFile + ' мс / песочницы ' + g.tSbx + ' мс');

  var t0  = Date.now();
  var src = read_();
  var tRead = Date.now() - t0;
  var t1  = Date.now();
  var sum = sum_(src.rows, JSON.stringify(src.rows));
  var tSum = Date.now() - t1;
  Logger.log('в мастере сейчас: ' + src.rows.length + ' строк (лист - ' + src.srcRows + '), сумма=' + sum);
  Logger.log('время: чтение ' + tRead + ' мс / сумма (stringify+MD5) ' + tSum + ' мс');
  if (meta && meta.rows !== src.rows.length) {
    Logger.log('⚠ расхождение: в снимке ' + meta.rows + ' строк, в мастере ' + src.rows.length);
  }
  return meta;
}

/**
 * УЧЁТ ИСХОДОВ ПРОГОНА - печатает в журнал последние STAT_SHOW_DAYS суток. Запускать РУКАМИ.
 * Строка: «2026-08-19  не менялось 61  отложено 22  опубликовано 13».
 * ⚠ Пустые сутки печатаются НУЛЯМИ, а не пропускаются: пропуск читается как «данных нет»,
 *   а три нуля говорят «прогонов не было» - это разные вещи, и вторая означает беду с триггером.
 */
function showStats() {
  var p = PropertiesService.getScriptProperties();
  var now = new Date(), tot = [0, 0, 0];
  Logger.log('Исходы прогонов за ' + STAT_SHOW_DAYS + ' суток (сутки по ' + STAT_TZ + '):');
  for (var i = STAT_SHOW_DAYS - 1; i >= 0; i--) {
    var key = statKey_(new Date(now.getTime() - i * 86400000));
    var v = statParse_(p.getProperty(key));
    tot[0] += v[0]; tot[1] += v[1]; tot[2] += v[2];
    Logger.log(key.substring(5) + '  не менялось ' + v[0] + '  отложено ' + v[1] +
               '  опубликовано ' + v[2]);
  }
  Logger.log('ИТОГО  не менялось ' + tot[0] + '  отложено ' + tot[1] + '  опубликовано ' + tot[2]);
  // ⚠ Сумма трёх чисел - это прогоны, ДОШЕДШИЕ ДО РЕШЕНИЯ, а не число выполнений в истории:
  //   пропуск по блокировке и отказ сторожа в счёт не идут (почему - в шапке stat_).
  return { same: tot[0], def: tot[1], pub: tot[2] };
}

/**
 * Отметка исхода прогона. Три метки: 'same' - публиковать нечего, 'def' - есть что, но окно
 * MIN_PUBLISH_MIN ещё не открылось, 'pub' - опубликовали новое поколение.
 *
 * Зачем счётчик вообще: 'gen' - это МЕТКА ВРЕМЕНИ ('20260818-222319'), а не порядковый номер,
 * поэтому число публикаций за сутки из него не вычитается, а без него исходящий трафик RTDB
 * не разложить на «часто публикуем» и «снимок тяжёлый». Дельты и чистка колонок помогут только
 * во втором случае, поэтому цифра нужна ДО правок, а не после.
 *
 * ⚠ ХРАНИМ ТОЛЬКО В СВОЙСТВАХ СКРИПТА. Ни в meta, ни где-либо ещё в RTDB счётчику не место:
 *   мы меряем исходящий трафик базы, а не создаём его.
 * ⚠ УЧЁТ НЕ ИМЕЕТ ПРАВА РОНЯТЬ ПУБЛИКАЦИЮ: любой сбой записи - предупреждение в журнал и выход.
 *   На момент вызова из ветки 'pub' снимок уже в базе, и исключение отсюда объявило бы
 *   состоявшуюся публикацию ошибкой.
 * ⚠ ЧТО В СЧЁТ НЕ ИДЁТ, сознательно: пропуск по LockService (это не исход прогона, а его
 *   отсутствие - другое выполнение ещё работает) и отказ сторожа guard_ (о нём приходит письмо
 *   и остаётся свойство 'lastAbort', молчаливым он не бывает). Отсюда инвариант:
 *   same + def + pub = прогоны, дошедшие до решения, а НЕ длина истории выполнений.
 * ⚠ Неизвестная метка не приписывается к соседнему счётчику, а КРИЧИТ: описка в новой ветке
 *   иначе тихо раздувала бы 'pub', то есть ровно то число, ради которого всё заведено.
 */
function stat_(kind) {
  try {
    var i = { same: 0, def: 1, pub: 2 }[kind];
    if (i === undefined) { Logger.log('⚠ Счётчик исходов: неизвестная метка «' + kind + '»'); return; }
    var p   = PropertiesService.getScriptProperties();
    var key = statKey_(new Date());
    var was = p.getProperty(key);
    var v   = statParse_(was);
    v[i]++;
    p.setProperty(key, v.join('|'));
    // Чистка - только в ПЕРВЫЙ прогон суток (ключа ещё не было): getProperties() тянет все
    // свойства проекта, звать её 96 раз в сутки незачем, а раз в сутки - ровно то, что нужно.
    if (!was) statPrune_(p);
  } catch (e) {
    Logger.log('⚠ Счётчик исходов не записан (' + kind + '): ' + (e && e.message ? e.message : e));
  }
}

/** Ключ суток: 'stat_YYYY-MM-DD'. Формат сортируемый - на нём же держится чистка по возрасту. */
function statKey_(d) { return 'stat_' + Utilities.formatDate(d, STAT_TZ, 'yyyy-MM-dd'); }

/** 'a|b|c' → [same, def, pub]. Пустое и битое значение читается как нули, а не как отказ. */
function statParse_(v) {
  var a = String(v || '').split('|');
  return [parseInt(a[0], 10) || 0, parseInt(a[1], 10) || 0, parseInt(a[2], 10) || 0];
}

/** Удаляет счётчики старше STAT_KEEP_DAYS суток. Список «оставить» строится по тем же ключам. */
function statPrune_(p) {
  var keep = {}, now = Date.now();
  for (var i = 0; i < STAT_KEEP_DAYS; i++) keep[statKey_(new Date(now - i * 86400000))] = 1;
  var all = p.getProperties(), del = 0;
  for (var k in all) if (k.indexOf('stat_') === 0 && !keep[k]) { p.deleteProperty(k); del++; }
  if (del) Logger.log('Счётчик исходов: удалено суток - ' + del + ' (храним ' + STAT_KEEP_DAYS + ')');
}

// ─────────────────────────────────────────────────────────────────────────────────────────────

function run_(force, tag) {
  // LockService на ВЕСЬ прогон: не пересечься ни с архивным скриптом, ни с самим собой
  // (15-минутный триггер против прогона, который затянулся на сжатии 23 МБ).
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(30 * 1000)) { Logger.log('Прогон пропущен: занят другим выполнением'); return null; }

  try {
    var p  = PropertiesService.getScriptProperties();
    var t0 = Date.now();
    var how = tag ? tag.toUpperCase() + ': ' : '';

    // ── ВСЕ выходы run_ идут через эту воронку: она печатает строку журнала, отмечает исход
    //    и отдаёт значение наружу. Смысл - ровно один вызов stat_ на исход и невозможность
    //    «забыть счётчик» в новой ветке: ветка обязана вернуть fin(), иначе она ничего не пишет
    //    в журнал, а это видно сразу. Время прогона дописывается здесь же, одним местом.
    var fin = function (kind, msg, ret) {
      Logger.log(msg + ' · прогон ' + (Date.now() - t0) + ' мс');
      stat_(kind);
      return ret === undefined ? null : ret;
    };

    // ── Рубежи 1 и 2 (дешёвые). Считаем ВСЕГДА, в том числе на force: иначе после суточного
    //    прогона свойства остались бы от прошлой сверки, и следующий обычный прогон полез бы
    //    в полное чтение зря. Цена - доли секунды, см. замеры в строке журнала.
    var g = gates_(p);
    // ⚠ Рубеж 1 запоминаем СРАЗУ, до всякой публикации: правка мастера УЖЕ в книге, а публикация
    //   может законно не состояться (правили другой лист - MD5 массива тот же), и фиксируй мы его
    //   только при публикации, эта же правка гоняла бы полное чтение на каждом прогоне.
    if (g.mtime) p.setProperty('srcMtime', g.mtime);
    // ⚠ Рубеж 2 - НАОБОРОТ, только при публикации (см. отложенную фиксацию в шапке): правка
    //   песочницы ещё В ПУТИ, и запомнить её время раньше прихода данных значит потерять правку.
    //   Исключение одно - первый прогон, когда откладывать нечего: ждать нам нечего, эталона нет.
    if (g.sbx && !p.getProperty('sandboxMtimes')) p.setProperty('sandboxMtimes', g.sbx);
    var gTimes = 'время файла ' + g.tFile + ' мс / песочницы ' + g.tSbx + ' мс';

    // ⚠ 'deferred' - есть НЕОПУБЛИКОВАННАЯ правка, отложенная ограничением частоты (см. шапку).
    //   Без него молчание рубежей похоронило бы её до суточного прогона: время мастера уже
    //   зафиксировано строкой выше, второй раз рубеж на ту же правку не сработает.
    var defer = p.getProperty('deferred') === '1';

    if (!force && !g.hit && !defer) {
      return fin('same', 'Рубежи молчат: мастер не правили, песочницы не менялись - ' +
                 'книгу НЕ ОТКРЫВАЕМ · ' + gTimes);
    }

    // meta прошлой публикации нужна троим: ограничению частоты, сторожу (сравнение числа строк)
    // и проверке «данные не менялись». Запрос крошечный - это указатель, а не данные.
    var prev  = rtdbGet_(ROOT + '/meta');
    var mins  = sincePub_(prev);
    var early = !force && mins != null && mins < MIN_PUBLISH_MIN;

    // Отложенная правка ждёт своего часа, а нового повода нет - книгу открывать незачем:
    // читать её сейчас значит потратить 12 секунд ради ответа, который мы уже знаем.
    // ⚠ При СРАБОТАВШЕМ рубеже читаем всё равно: пока не прочитали, неизвестно, есть ли вообще
    //   что публиковать (мастер могли править на другом листе - массив тот же), а ставить
    //   'deferred' наугад значит гонять полное чтение по любому касанию книги.
    if (early && defer && !g.hit) {
      return fin('def', 'Отложенная правка ждёт: с прошлой публикации ' + Math.round(mins) +
                 ' мин из ' + MIN_PUBLISH_MIN + ' - книгу НЕ ОТКРЫВАЕМ · ' + gTimes);
    }

    Logger.log(how + (force ? 'рубежи не спрашиваем, публикуем безусловно'
                            : (g.hit ? 'рубеж сработал - ' + g.why
                                     : 'рубежи молчат, но есть отложенная правка')) +
               ' → читаем ' + SRC_SHEET + ' · ' + gTimes);

    var tR   = Date.now();
    var src  = read_();
    var rows = src.rows;
    var tRead = Date.now() - tR;

    // ⚠ JSON считается ЗДЕСЬ, ДО проверки «не менялось»: контрольная сумма - MD5 от него (см. шапку).
    //   Значит его цену платит каждый прогон, ДОШЕДШИЙ ДО ЧТЕНИЯ, - отсюда и замеры в журнале.
    //   Gzip остаётся ниже - его до проверки считать незачем, он дороже всего в скрипте.
    var t1   = Date.now();
    var json = JSON.stringify(rows);
    var sum  = sum_(rows, json);
    var tSum = Date.now() - t1;
    var times = gTimes + ' / чтение ' + tRead + ' мс / сумма ' + tSum + ' мс';

    // ── Данные не менялись - выходим, не трогая базу. На этот случай придётся БОЛЬШИНСТВО прогонов.
    // ⚠ Сверяемся не только с локальной суммой, но и с тем, что снимок реально ЛЕЖИТ в базе и это
    //   наше поколение: иначе после удаления ветки (или чужой перезаписи) сумма совпадала бы вечно,
    //   и скрипт молча не публиковал бы никогда - самый неприятный из возможных отказов, немой.
    if (!force && sum === p.getProperty('sum') && prev && prev.gen === p.getProperty('gen')) {
      // Публиковать нечего - снимаем отложенную правку, если она числилась за нами.
      p.deleteProperty('deferred');
      // Причину рубежа не повторяем - она напечатана строкой выше, в том же выполнении.
      // Если повод дала ПЕСОЧНИЦА - это ожидаемое состояние «правка ещё в пути», а не пустой
      // прогон: время не фиксируем и вернёмся сюда на следующем прогоне (_sbxWait).
      return fin('same', 'Данные не менялись (' + rows.length + ' строк, сумма ' + sum +
                 '): массив ' + SRC_SHEET + ' тот же, публикации нет. ' +
                 (g.sbxHit ? _sbxWait(p, g) : '') + '· ' + times);
    }

    // ── Изменения ЕСТЬ, но публиковать ещё рано: меньше MIN_PUBLISH_MIN минут с прошлой публикации.
    // ⚠ НИЧЕГО НЕ ЗАПОМИНАЕМ - ни 'sum', ни 'sandboxMtimes', ни счётчик 'sandboxRetry': запомнить
    //   здесь хоть что-нибудь значит объявить опубликованным то, что в базу не уехало, и потерять
    //   правку молча (подробности в шапке). Ставим только флаг «есть чего ждать».
    if (early) {
      p.setProperty('deferred', '1');
      return fin('def', 'Изменения есть (' + rows.length + ' строк, сумма ' + sum + '), но с прошлой ' +
                 'публикации прошло ' + Math.round(mins) + ' мин - ждём до ' + MIN_PUBLISH_MIN +
                 '. Публикации нет, ничего не фиксируем; правка уедет первым прогоном после окна. · ' +
                 times);
    }

    if (!force) {
      var why = guard_(rows, prev, p);
      if (why) return abort_(why, rows, prev);
    }

    // ── Упаковка. gzip → base64. Тот же массив, что отдаёт Sheets API в values.
    var b64 = Utilities.base64Encode(Utilities.gzip(Utilities.newBlob(json, 'application/json')).getBytes());
    var parts = {};
    var n = 0;
    for (var i = 0; i < b64.length; i += CHUNK) { parts[String(n++)] = b64.substr(i, CHUNK); }

    var tz  = src.tz;
    var now = new Date();
    var gen = Utilities.formatDate(now, tz, 'yyyyMMdd-HHmmss');

    // ── Публикация: СНАЧАЛА данные, ПОТОМ указатель (см. шапку - порядок обязателен).
    rtdbPut_(ROOT + '/gen/' + gen, parts);
    var meta = {
      gen: gen,
      rows: rows.length,           // строк в снимке, включая заголовок
      cols: COLS,
      chunks: n,
      bytes: b64.length,           // размер base64 - столько скачает клиент
      updatedAt: now.toISOString(),
      srcRows: src.srcRows         // строк на листе-источнике (до отсечения пустого хвоста)
    };
    rtdbPut_(ROOT + '/meta', meta);

    // Локальные отметки - ТОЛЬКО после успешной публикации: иначе следующий прогон счёл бы
    // непрошедший снимок опубликованным и не повторил бы попытку (тот же инвариант, что
    // у зеркала localStorage в дашборде - хранится ПОСЛЕДНЕЕ ИЗВЕСТНОЕ ОБЛАКО).
    var save = {
      sum: sum,
      gen: gen,
      head: headKey_(rows[0]),
      publishedAt: now.toISOString()
    };
    // ⚠ ВОТ ЕДИНСТВЕННОЕ МЕСТО, где фиксируется рубеж 2: данные песочницы доехали и опубликованы.
    //   Записать его где-то ещё - значит вернуть потерю правки, ради которой заведена отсрочка.
    if (g.sbx) save.sandboxMtimes = g.sbx;
    p.setProperties(save, false);
    p.deleteProperty('sandboxRetry');
    p.deleteProperty('deferred');

    prune_(gen, prev && prev.gen);
    // ⚠ «с прошлой публикации N мин» - не косметика: по этому числу видно, работает ли ограничение
    //   частоты и не копится ли задержка (интервал заметно больше MIN_PUBLISH_MIN означает, что
    //   правки лежат дольше положенного - смотреть, почему прогон до них не доходит).
    return fin('pub', how + 'Снимок опубликован: поколение ' + gen + ' · ' + rows.length +
               ' строк · ' + n + ' кусков · ' + Math.round(b64.length / 1024) + ' КБ (json ' +
               Math.round(json.length / 1024 / 1024) + ' МБ) · с прошлой публикации ' +
               (mins == null ? 'первая публикация' : Math.round(mins) + ' мин') + ' · ' + times,
               meta);

  } catch (e) {
    // Сюда попадают отказы RTDB и сбои чтения мастера. Молчать нельзя: триггер живёт сам по себе,
    // и в журнал никто не смотрит, пока что-нибудь не сломается на стороне дашборда.
    Logger.log('ОШИБКА публикации: ' + (e && e.message ? e.message : e));
    alert_('Снимок не опубликован: ошибка',
           'Скрипт публикации снимка упал с ошибкой:\n\n' + (e && e.stack ? e.stack : e) +
           '\n\nПрежний снимок в базе не тронут - дашборд, когда научится его читать, ' +
           'продолжит работать на нём.');
    throw e;
  } finally {
    lock.releaseLock();
  }
}

/** MD5 в hex - контрольная сумма снимка (рубежи с 17.08.2026 хэш не считают, им хватает времён). */
function md5_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, s)
    .map(function (b) { return ('0' + (b & 0xFF).toString(16)).slice(-2); })
    .join('');
}

/**
 * Сколько минут прошло с прошлой публикации по meta.updatedAt. null - публикаций ещё не было
 * (или метка нечитаема), и тогда ограничение частоты не применяется: первый снимок обязан уехать.
 * ⚠ Отрицательную разницу (метка из будущего - разъехались часы) приводим к нулю, то есть считаем
 *   «только что опубликовано» и ЖДЁМ. Обратное - счесть её за «давно» и публиковать - вернуло бы
 *   публикацию каждые 15 минут ровно в том случае, когда её нечем заметить.
 */
function sincePub_(prev) {
  if (!prev || !prev.updatedAt) return null;
  var t = Date.parse(prev.updatedAt);
  if (!t) return null;
  return Math.max(0, (Date.now() - t) / 60000);
}

/** Метка времени файла для журнала: голое число миллисекунд человеку ничего не говорит. */
function _mtimeTxt(ms) {
  if (!ms) return '-';
  var d = new Date(Number(ms));
  return isNaN(d) ? String(ms) : Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd.MM.yyyy HH:mm:ss');
}

/**
 * Два дешёвых рубежа перед полным чтением. Возвращает {hit, why, mtime, sbx, sbxHit, tFile, tSbx};
 * hit === true означает «есть повод читать 62 тыс. строк», sbxHit - что повод дала ПЕСОЧНИЦА
 * (у неё особый порядок фиксации, см. отложенную фиксацию в шапке).
 * ⚠ Книгу НЕ ОТКРЫВАЕТ - только метаданные Drive. В этом весь смысл правки 17.08.2026: прежняя
 *   версия читала лист 03 и платила 15,6 с за синхронный пересчёт IMPORTRANGE.
 * ⚠ НИЧЕГО НЕ ЗАПИСЫВАЕТ - свойства ставит вызывающий (диагностике snapshotStatus менять
 *   состояние скрипта нельзя).
 * ⚠ Ошибаться эта функция имеет право ТОЛЬКО в сторону лишней работы: любой сбой - это hit,
 *   а не «ничего не менялось». Иначе снятое право на Drive или удалённая песочница превращали бы
 *   скрипт в немой - он бы бодро отчитывался о прогонах и не публиковал никогда.
 */
function gates_(p) {
  var g = { hit: false, why: '', mtime: '', sbx: '', sbxHit: false, tFile: 0, tSbx: 0, names: [] };

  var t0 = Date.now();
  try {
    // Рубеж 1 - время изменения файла мастера. Ловит ручную правку в книге; пересчёт IMPORTRANGE
    // его НЕ двигает (формулы не меняют файл), поэтому одного этого рубежа мало - см. рубеж 2.
    g.mtime = String(DriveApp.getFileById(MASTER_ID).getLastUpdated().getTime());
    g.tFile = Date.now() - t0;

    // Рубеж 2 - время изменения песочниц. Имя берём у того же объекта File (метаданные уже
    // получены, лишнего запроса нет) - в журнале должно быть видно, КАКУЮ песочницу правили.
    var t1 = Date.now(), a = [];
    for (var i = 0; i < SANDBOX_IDS.length; i++) {
      var f = DriveApp.getFileById(SANDBOX_IDS[i]);
      a.push(String(f.getLastUpdated().getTime()));
      g.names.push(f.getName());
    }
    g.sbx  = a.join('|');
    g.tSbx = Date.now() - t1;
  } catch (e) {
    g.hit = true;
    g.why = 'рубежи не отработали (' + (e && e.message ? e.message : e) + ') - читаем полностью, ' +
            'как до 16.08.2026; данные от этого верные, теряется только экономия времени. ' +
            'Если это «Drive» или «permission» - в манифест не добавлен scope drive.readonly; ' +
            'если «No item with the given ID» - песочницу из SANDBOX_IDS удалили или закрыли доступ';
    return g;
  }

  var wasM = p.getProperty('srcMtime');
  var wasS = p.getProperty('sandboxMtimes');
  if (!wasM || !wasS) {
    g.hit = true;
    g.why = 'рубежи ещё не запомнены - первый прогон после выкладки';
  } else if (g.mtime !== wasM) {
    g.hit = true;
    g.why = 'мастер правили: файл изменён ' + _mtimeTxt(g.mtime) + ', в прошлый раз было ' + _mtimeTxt(wasM);
  } else if (g.sbx !== wasS) {
    g.hit = true;
    g.sbxHit = true;
    g.why = 'правили песочницу (' + _sbxWho(g, wasS) + ') - ждём, пока IMPORTRANGE довезёт данные';
  }
  return g;
}

/**
 * Рубеж 2 сработал, а массив не изменился - правка песочницы ещё в пути. Считает попытки
 * и возвращает строку для журнала. ⚠ Время НЕ фиксируется, поэтому следующий прогон снова
 * пойдёт на полное чтение - именно так отсрочка и работает, отдельного «повторить» не нужно.
 * ⚠ Исчерпали предел - фиксируем принудительно и КРИЧИМ: полтора часа это уже не задержка
 *   IMPORTRANGE, а сломанная формула, и молча читать книгу вечно нельзя.
 */
function _sbxWait(p, g) {
  var n = Number(p.getProperty('sandboxRetry') || 0) + 1;
  if (n >= SBX_RETRY_MAX) {
    p.setProperty('sandboxMtimes', g.sbx);
    p.deleteProperty('sandboxRetry');
    return '⚠ ПРАВКА В ПЕСОЧНИЦЕ ТАК И НЕ ДОЕХАЛА за ' + SBX_RETRY_MAX + ' попыток (~' +
           (SBX_RETRY_MAX * 15 / 60).toFixed(1).replace('.', ',') + ' ч): время фиксируем принудительно, ' +
           'чтобы не читать книгу вечно. ПРОВЕРИТЬ ФОРМУЛУ IMPORTRANGE на листе ' + EXT_SHEET +
           ' и состав SANDBOX_IDS. ';
  }
  p.setProperty('sandboxRetry', String(n));
  return 'Правка в песочнице ещё не доехала - повтор ' + n + ' из ' + SBX_RETRY_MAX + '. ';
}

/** Какие именно песочницы сдвинулись - по позициям в склеенной строке времён. Для журнала. */
function _sbxWho(g, was) {
  var cur = String(g.sbx).split('|'), old = String(was).split('|'), out = [];
  for (var i = 0; i < cur.length; i++) {
    if (cur[i] !== old[i]) out.push((g.names[i] || SANDBOX_IDS[i]) + ' → ' + _mtimeTxt(cur[i]));
  }
  return out.length ? out.join('; ') : 'состав файлов изменился';
}

/**
 * Чтение мастера напрямую. Возвращает {rows, srcRows, tz}.
 * ⚠ Диапазон берётся ЖЁСТКО A:O по позициям, а не getDataRange(): лишняя служебная колонка,
 *   дописанная справа в мастере, не должна доехать до дашборда - он читает по индексам.
 */
function read_() {
  var ss = SpreadsheetApp.openById(MASTER_ID);
  var sh = ss.getSheetByName(SRC_SHEET);
  if (!sh) throw new Error('В мастере нет листа «' + SRC_SHEET + '»');

  var tz = ss.getSpreadsheetTimeZone() || 'Europe/Moscow';
  // ⚠ Серийные номера дат считаются по компонентам локального времени скрипта. Разъедься
  //   таймзона скрипта с таймзоной книги - все даты уехали бы на разницу поясов МОЛЧА.
  var stz = Session.getScriptTimeZone();
  if (stz && stz !== tz) {
    throw new Error('Таймзона скрипта (' + stz + ') не совпадает с таймзоной книги (' + tz +
                    '). Даты в снимке уехали бы на разницу поясов. Выровнять в настройках проекта.');
  }

  var last = sh.getLastRow();
  if (!last) throw new Error('Лист «' + SRC_SHEET + '» пуст');
  var vals = sh.getRange(1, 1, last, COLS).getValues();

  // Пустой хвост отсекаем: подтянутые вниз формулы в мастере оставляют строки из пятнадцати ''.
  var end = vals.length;
  while (end > 0 && isBlankRow_(vals[end - 1])) end--;
  vals.length = end;

  for (var r = 0; r < vals.length; r++) {
    var row = vals[r];
    for (var c = 0; c < COLS; c++) {
      var v = row[c];
      if (v instanceof Date) row[c] = serial_(v);
      else if (v === null || v === undefined) row[c] = '';
    }
  }
  return { rows: vals, srcRows: last, tz: tz };
}

/** Дата → серийный номер Sheets (то же, что отдаёт API при dateTimeRenderOption=SERIAL_NUMBER). */
function serial_(d) {
  var days = Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000 + EPOCH_DAYS;
  var secs = d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds();
  return secs ? days + secs / 86400 : days;
}

function isBlankRow_(row) {
  for (var c = 0; c < COLS; c++) { if (row[c] !== '' && row[c] !== null && row[c] !== undefined) return false; }
  return true;
}

/**
 * Контрольная сумма: строк | Σ поступлений | Σ списаний | MD5 всего массива.
 * ⚠ РЕШАЕТ сумма ТОЛЬКО последняя часть - MD5 от того самого JSON, который уезжает в базу.
 *   Первые три - для человека в журнале: MD5 не говорит ничего, а по ним сразу видно масштаб
 *   изменения. До 16.08.2026 суммой были только они, и правка любой нечисловой ячейки скрипт
 *   не будила - см. подробности в шапке файла.
 * Копейки в суммах округляем: на 60 тыс. слагаемых хвост float гуляет в последних разрядах.
 * ⚠ json приходит АРГУМЕНТОМ, а не считается здесь: он же нужен вызывающему для gzip, и второй
 *   stringify на 23,5 МБ - это лишние секунды на каждом прогоне.
 */
function sum_(rows, json) {
  var inc = 0, out = 0;
  for (var r = 1; r < rows.length; r++) {
    inc += Number(rows[r][C_INCOME])  || 0;
    out += Number(rows[r][C_OUTCOME]) || 0;
  }
  return rows.length + '|' + inc.toFixed(2) + '|' + out.toFixed(2) + '|' + md5_(json);
}

/** Нормализованная строка заголовков - тем же способом, что сверяет дашборд (NBSP, регистр, пробелы). */
function headKey_(head) {
  var a = [];
  for (var c = 0; c < COLS; c++) {
    a.push(String(head && head[c] != null ? head[c] : '')
      .replace(/ /g, ' ').replace(/\s+/g, ' ').trim().toLowerCase());
  }
  return a.join('|');
}

/**
 * Сторож. Возвращает причину отказа или null.
 * ⚠ Здесь он критичнее, чем в архивном скрипте: битый архив просто лежит, а битый снимок
 *   за полминуты разъедется по всем открытым дашбордам. Поэтому «не опубликовать» - всегда
 *   лучше, чем «опубликовать сомнительное»: прежнее поколение остаётся на месте и живо.
 */
function guard_(rows, prev, p) {
  if (rows.length < MIN_ROWS) {
    return 'строк всего ' + rows.length + ' при минимуме ' + MIN_ROWS;
  }
  if (prev && prev.rows && rows.length < prev.rows * ROWS_RATIO) {
    return 'строк стало ' + rows.length + ' против ' + prev.rows + ' в прошлой публикации (порог - ' +
           Math.round(ROWS_RATIO * 100) + '%)';
  }

  var head = headKey_(rows[0]);
  var was  = p.getProperty('head');
  if (was && was !== head) {
    var a = was.split('|'), b = head.split('|'), diff = [];
    for (var i = 0; i < COLS; i++) { if (a[i] !== b[i]) diff.push('#' + (i + 1) + ': «' + (a[i] || '-') + '» → «' + (b[i] || '-') + '»'); }
    return 'изменилась строка заголовков (' + diff.join('; ') + ')';
  }
  // Шапка целиком пустой/битой не бывает у живого листа - это признак того, что мастер
  // читается в момент пересборки. Первый прогон эталона ещё не имеет, и без этой проверки
  // он бы такое состояние ЗАПОМНИЛ как эталон.
  var hc = head.split('|');
  for (var k = 0; k < COLS; k++) {
    if (hc[k] === '' || hc[k].charAt(0) === '#') return 'шапка невалидна (колонка #' + (k + 1) + ': «' + hc[k] + '»)';
  }

  // Маркеры незавершённого импорта в первой колонке (там дата ДДС - текст в ней уже подозрителен).
  for (var r = 1; r < rows.length; r++) {
    var v = rows[r][0];
    if (typeof v !== 'string' || !v) continue;
    var s = v.toLowerCase();
    for (var m = 0; m < BAD_MARKERS.length; m++) {
      if (s.indexOf(BAD_MARKERS[m]) >= 0) {
        return 'в первой колонке строки ' + (r + 1) + ' лежит «' + v + '» - источник ещё считается';
      }
    }
  }
  return null;
}

/** Отказ: прежний снимок ОСТАЁТСЯ в базе. Плюс письмо, но не чаще раза в час. */
function abort_(why, rows, prev) {
  Logger.log('ОТКАЗ от публикации: ' + why);
  PropertiesService.getScriptProperties().setProperty('lastAbort', new Date().toISOString() + ' · ' + why);
  alert_('Снимок данных НЕ опубликован',
    'Скрипт публикации снимка отказался писать в базу.\n\n' +
    'Причина: ' + why + '.\n\n' +
    'Было в прошлой публикации: ' + (prev && prev.rows ? prev.rows + ' строк (' + prev.updatedAt + ')' : 'публикаций ещё не было') + '.\n' +
    'Стало сейчас в мастере: ' + rows.length + ' строк.\n\n' +
    'ПРЕЖНИЙ СНИМОК ЦЕЛ и лежит в базе - ничего не потеряно. Скрипт повторит попытку на следующем ' +
    'прогоне (раз в 15 минут) и опубликует сам, как только данные придут в порядок. ' +
    'Если это ожидаемое изменение (например, колонки в мастере переставили намеренно) - ' +
    'запустить publishSnapshotForce() руками из редактора скриптов.');
  return null;
}

/** Письмо с ограничением частоты: 15-минутный триггер иначе завалил бы почту за ночь. */
function alert_(subject, body) {
  try {
    var p = PropertiesService.getScriptProperties();
    var last = Number(p.getProperty('lastAlertAt') || 0);
    if (Date.now() - last < ALERT_EVERY) { Logger.log('Письмо подавлено (было менее часа назад)'); return; }
    MailApp.sendEmail({ to: ALERT_TO, subject: '[Дашборд] ' + subject, body: body });
    p.setProperty('lastAlertAt', String(Date.now()));
  } catch (e) {
    Logger.log('Письмо отправить не удалось: ' + (e && e.message ? e.message : e));
  }
}

/** Чистка старых поколений. Держим текущее и предыдущее - на предыдущем ещё могут сидеть клиенты. */
function prune_(cur, prevGen) {
  var list = rtdbGet_(ROOT + '/gen', 'shallow=true'); // ⚠ именно shallow: иначе выкачали бы все поколения
  if (!list) return;
  var keep = {};
  keep[cur] = 1;
  if (prevGen) keep[prevGen] = 1;
  var names = Object.keys(list).sort();
  // Если поколений накопилось больше KEEP_GENS (после ручных прогонов) - оставляем самые свежие.
  while (names.length && Object.keys(keep).length < KEEP_GENS) { keep[names[names.length - 1]] = 1; names.pop(); }
  for (var i = 0; i < names.length; i++) {
    if (keep[names[i]]) continue;
    rtdbDel_(ROOT + '/gen/' + names[i]);
    Logger.log('Удалено старое поколение: ' + names[i]);
  }
}

// ── RTDB REST. Авторизация - токеном самого скрипта, служебного аккаунта и ключей нет ────────
function rtdbGet_(path, qs) {
  var r = fetch_(path + '.json' + (qs ? '?' + qs : ''), { method: 'get' });
  var t = r.getContentText();
  return (!t || t === 'null') ? null : JSON.parse(t);
}
function rtdbPut_(path, val) {
  fetch_(path + '.json', { method: 'put', contentType: 'application/json', payload: JSON.stringify(val) });
}
function rtdbDel_(path) {
  fetch_(path + '.json', { method: 'delete' });
}
function fetch_(path, opt) {
  opt.headers = { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() };
  opt.muteHttpExceptions = true; // код ответа разбираем сами - иначе в журнал уедет HTML-страница ошибки
  var r = UrlFetchApp.fetch(DB_URL + '/' + path, opt);
  var c = r.getResponseCode();
  if (c < 200 || c >= 300) {
    throw new Error('RTDB ' + opt.method.toUpperCase() + ' ' + path + ' → HTTP ' + c + ': ' +
                    String(r.getContentText()).slice(0, 400));
  }
  return r;
}
